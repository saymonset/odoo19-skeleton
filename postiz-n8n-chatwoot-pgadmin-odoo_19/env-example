# App
############################
VERSION=19

############################
# PostgreSQL Odoo 19
############################
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_USER=odoo
POSTGRES_DB=dbodoo19
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password   # Define el secreto externamente

DB_HOST=db
DB_PORT=5432

############################
# n8n
############################
N8N_USER=admin
N8N_PASSWORD_FILE=/run/secrets/n8n_password            # Secreto externo
N8N_ENCRYPTION_KEY_FILE=/run/secrets/n8n_encryption_key
N8N_RUNNERS_ENABLED=true
N8N_CORS_ALLOW_CREDENTIALS=true
N8N_CORS_ALLOW_ORIGIN=*

N8N_REDIS_HOST=redis
N8N_REDIS_PORT=6379
N8N_REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD
N8N_REDIS_DB_INDEX=1

N8N_CACHE_TYPE=redis
N8N_CACHE_REDIS_HOST=redis
N8N_CACHE_REDIS_PORT=6379
N8N_CACHE_REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD
N8N_CACHE_REDIS_DB=1

N8N_QUEUE_BULL_REDIS_HOST=redis
N8N_QUEUE_BULL_REDIS_PORT=6379
N8N_QUEUE_BULL_REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD
N8N_QUEUE_BULL_REDIS_DB=1

N8N_EDITOR_BASE_URL=https://n8n.tudominio.com
N8N_PUSH_BACKEND=websocket
N8N_PUSH_REDIS_HOST=redis
N8N_PUSH_REDIS_PORT=6379
N8N_PUSH_REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD
N8N_PUSH_REDIS_DB=1

REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD

