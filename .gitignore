# dotfiles, with exceptions:
.*
!.gitignore

# python compiled files
*.py[co]

# emacs backup files
*~

# not tracked subdirectories
/env/
/src/
/filestore/
/logs/

# Backups y datos locales
v19/data.backup.*/
v19/addons.backup.*/
!v19/backups/*.dump
!v19/backups/*.tar.gz
!*.dump
!*.tar.gz

# Nueva instancia leads (v18_2)
leads/odoo_instancia_2/v18_2/addons/extra/chat-bot-unisa/
leads/odoo_instancia_2/v18_2/pgdata/
leads/odoo_instancia_2/v18_2/n8n_data/
leads/odoo_instancia_2/v18_2/odoo-web-data/
leads/odoo_instancia_2/v18_2/logs/
leads/odoo_instancia_2/v18_2/filestore/

# Excepción para el archivo de configuración de Odoo
!leads/odoo_instancia_2/v18_2/config/odoo.conf

# ----- Instancia Odoo 19 (postiz-n8n-chatwoot-pgadmin-odoo_19) -----
postiz-n8n-chatwoot-pgadmin-odoo_19/.env
postiz-n8n-chatwoot-pgadmin-odoo_19/secrets/
!postiz-n8n-chatwoot-pgadmin-odoo_19/backup/
!postiz-n8n-chatwoot-pgadmin-odoo_19/v19/backups/

# Ignorar backups automáticos de Odoo (carpeta out)
postiz-n8n-chatwoot-pgadmin-odoo_19/backup/out/
postiz-n8n-chatwoot-pgadmin-odoo_19/backup/out/*
# Excepción: mantener la estructura de carpetas
!postiz-n8n-chatwoot-pgadmin-odoo_19/backup/out/.gitkeep
!postiz-n8n-chatwoot-pgadmin-odoo_19/backup/out/README.md

# Datos de Odoo
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/data/
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/logs/
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/n8n_data/
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/odoo-web-data/
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/odoo_n8n_pgdata/
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/pgadmin-data/
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/postiz_uploads/
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/redis_data/
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/data.backup.*/
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/addons.backup.*/

# Ignorar todas las carpetas que empiezan con chatwoot_
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/chatwoot_*/

# Excepción para conservar el config de Odoo si se necesitara (opcional)
# !postiz-n8n-chatwoot-pgadmin-odoo_19/v19/config/odoo.conf

# Logs y estado del monitor de BD (6_5_monitor_bd_salud.sh)
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/monitor_bd.log
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/monitor_bd.state

# Logs y estado del monitor de cliente testUsuario (6_6_monitor_cliente_testusuario.sh)
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/monitor_cliente_testusuario.log
postiz-n8n-chatwoot-pgadmin-odoo_19/v19/monitor_cliente_testusuario.state

# General data directories
**/temporal_elasticsearch_data/

# Credenciales R2 / backup remoto (config sensible)
postiz-n8n-chatwoot-pgadmin-odoo_19/cloudflare/

# Logs de backup
postiz-n8n-chatwoot-pgadmin-odoo_19/backup/*.log

# Exports de sesiones OpenCode (referencia, no versionar)
session-*.md
